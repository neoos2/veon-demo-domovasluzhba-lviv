---
// Functional line icons only (concept §5 «Іконки»): 2 px stroke in the text colour, decorative next to a visible label.
type Name = "phone" | "viber" | "telegram" | "arrow" | "chevron" | "menu" | "close";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
const d: Record<Name, string> = {
  phone: "M5.5 3.5h3l1.7 4.4-2.1 1.3a11.5 11.5 0 0 0 6.7 6.7l1.3-2.1 4.4 1.7v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2Z",
  viber: "M12 3c4.9 0 8 2.4 8 7.3S16.9 17.6 12 17.6h-.6L8 20.5v-3.4C5.4 16 4 13.8 4 10.3 4 5.4 7.1 3 12 3Z M9.6 7.6c.4 2.6 2.2 4.4 4.8 4.8 M12.4 6.9a2.7 2.7 0 0 1 2.3 2.3",
  telegram: "M20.5 4.5 3.5 11.2l5.4 1.9 2 6.4 3.1-3.6 4.6 3.4 1.9-14.8Z M8.9 13.1l11.6-8.6",
  arrow: "M5 12h14 M13 6l6 6-6 6",
  chevron: "m6 9 6 6 6-6",
  menu: "M4 7h16 M4 12h16 M4 17h16",
  close: "M6 6l12 12 M18 6 6 18",
};
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={d[name]} /></svg>
